{
  "name": "fakestore-api",
  "version": "1.0.0",
  "description": "FakeStore inventory API — Express 5 + PostgreSQL, raw parameterised SQL",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --import dotenv/config src/server.js",
