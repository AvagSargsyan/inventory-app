{
  "name": "fakestore-e2e",
  "version": "1.0.0",
  "description": "FakeStore end-to-end tests \u2014 Playwright driving the built SPA in a browser",
  "type": "module",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:watch": "SLOW_MO=800 playwright test --headed --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
