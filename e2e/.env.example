# Copy to .env.
#
# Leave E2E_TARGET as "local" and Playwright starts the API and the built SPA
# itself against TEST_DATABASE_URL, which the suite is free to destroy.
#
# Set E2E_TARGET=deployed with BASE_URL and API_URL pointing at a running
# environment to drive that instead; nothing is started and the database
# settings are ignored.
E2E_TARGET=local
BASE_URL=http://localhost:4173
API_URL=http://localhost:3100
TEST_DATABASE_URL=postgresql://USER@localhost:5432/fakestore_test
